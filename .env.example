# ── Open Aura — local configuration ───────────────────────────────────────
# Copy to .env and fill in a provider key. docker-compose reads these.
APP_ENV=local

# Postgres. docker-compose sets this for you (host "db"). For bare-metal, point
# it at a local Postgres that has schema.sql applied.
POSTGRES_URL=postgresql://aura:aura@localhost:5432/aura

# Scoring model + provider key — BRING YOUR OWN. Set the key for the provider
# your model uses (openai/* runs on Groq's OpenAI-compatible gpt-oss by default).
AURA_SCORING_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# MCP server port — point your agent at http://localhost:8090/mcp
AURA_MCP_PORT=8090

# ── PFG operational insights (EXPERIMENTAL — pfg-insights-poc branch) ──────
# Open Aura can ground a session against a Product Feature Graph and return
# advisory "check-tips" (current-vs-legacy, hand-rolled-vs-SDK, a standard/skill
# to adopt). It reads the REAL local diff/transcript you pass as `local_context`
# to score_this_session, derives tags locally, and resolves them READ-ONLY against
# the graph. OFF by default; it never affects your Aura score.
PFG_GROUNDING_ENABLED=false
# The PFG MCP endpoint (must include the /mcp path) + bearer token + workspace.
PFG_MCP_URL=
PFG_MCP_TOKEN=
# Workspace to ground against. A public catalog of SDKs/frameworks + Claude skills
# (e.g. public-graphs-by-vibelevel) is the best target for operational insights —
# it powers the hand-rolled-vs-SDK ("improve"), legacy ("currency"), and
# adopt-a-skill ("adopt") tips. Point this at YOUR OWN product graph instead only
# if you also want "graph gap" tips (you built something your graph doesn't map);
# those are suppressed for catalogs you don't curate.
PFG_WORKSPACE=public-graphs-by-vibelevel
# Local tag-extraction LLM pass (uses AURA_SCORING_MODEL). Set false for a
# deterministic-only extraction (manifests + diff imports + commands, no LLM).
PFG_EXTRACT_LLM=true
