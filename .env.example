# ── Open Aura — local configuration ───────────────────────────────────────
# Copy to .env and fill in a provider key. docker-compose reads these.
APP_ENV=local

# Postgres. docker-compose sets this for you (host "db"). For bare-metal, point
# it at a local Postgres that has schema.sql applied.
POSTGRES_URL=postgresql://aura:aura@localhost:5432/aura

# Scoring model + provider key — BRING YOUR OWN. OpenAI-compatible providers
# can be selected by setting OPENAI_BASE_URL (OpenCode's URL is shown below).
AURA_SCORING_MODEL=deepseek-v4-flash-free
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/v1
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# MCP server port — point your agent at http://localhost:8090/mcp
AURA_MCP_PORT=8090
