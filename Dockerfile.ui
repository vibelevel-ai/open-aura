# Optional local viewer image — the Aura code + Streamlit. It reuses the same
# source (so it calls build_profile directly) and adds only Streamlit on top.
# Build/run via the `ui` compose profile:  docker compose --profile ui up
FROM python:3.12-slim

WORKDIR /app

# Deps first for layer caching: core requirements + the UI-only extra.
COPY requirements.txt requirements-ui.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ui.txt

COPY . .

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
