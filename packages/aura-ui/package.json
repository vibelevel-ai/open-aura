{
  "name": "@vibelevel/aura-ui",
  "version": "0.1.0",
  "description": "Presentational, auth-free Aura viewer components (React/TypeScript) for Open Aura.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/aura-theme.css": "./src/styles/aura-theme.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test:activity": "node --test src/components/aura/aura-activity-data.test.cjs",
    "test:projects": "node --test src/components/aura/aura-projects.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": ">=13.4.4",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4"
  }
}
